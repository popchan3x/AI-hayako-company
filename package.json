{
  "name": "ai-hayako-company-market-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --use-system-ca src/server.js",
    "test": "node --test tests/*.test.js",
    "learn:daily": "node --use-system-ca scripts/daily-learn.js --provider=free-composite \"--intervals=1m,5m,15m,1h,4h,1d\"",
    "learn:daily:intraday": "node --use-system-ca scripts/daily-learn.js --provider=free-composite \"--intervals=1m,5m,15m,1h,4h\"",
    "learn:daily:1d": "node --use-system-ca scripts/daily-learn.js --provider=free-composite \"--intervals=1d\"",
    "learn:signals": "node --use-system-ca scripts/daily-learn.js --provider=free-composite \"--intervals=1m,5m,15m,1h,4h,1d\" --stage=signals",
    "learn:outcomes": "node --use-system-ca scripts/daily-learn.js --provider=free-composite \"--intervals=1m,5m,15m,1h,4h,1d\" --stage=outcomes",
    "learn:daily:demo": "node scripts/daily-learn.js --provider=demo \"--intervals=1m,5m,15m,1h,4h,1d\"",
    "learn:import-codex": "node scripts/import-codex-learning.js",
    "learn:consolidate": "node scripts/consolidate-learning-data.js",
    "audit:universe": "node scripts/audit-universe.js --concurrency=8 --provider=free-composite"
  },
  "engines": {
    "node": ">=22"
  }
}
